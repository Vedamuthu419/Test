1. CPU utilization trend — last 15 days
This query returns hourly average and peak CPU readings.

SELECT
    DATEADD(HOUR, DATEDIFF(HOUR, 0, [Time]), 0) AS HourlyTime,
    AVG(CAST([IdleCPU] AS FLOAT)) AS AvgIdleCPU,
    AVG(CAST([SQLUtilisedCPU] AS FLOAT)) AS AvgSQLUtilisedCPU,
    MAX(CAST([SQLUtilisedCPU] AS FLOAT)) AS PeakSQLUtilisedCPU,
    AVG(CAST([Otherprosses] AS FLOAT)) AS AvgOtherProcessesCPU,
    MAX(CAST([Otherprosses] AS FLOAT)) AS PeakOtherProcessesCPU
FROM [DBADB].[dbo].[CPUUtilisationdata]
WHERE [Time] >= DATEADD(DAY, -15, GETDATE())
  AND [Time] <= GETDATE()
GROUP BY DATEADD(HOUR, DATEDIFF(HOUR, 0, [Time]), 0)
ORDER BY HourlyTime DESC;



2. Memory performance trend — last 15 days
Your PageLifeExpectancyLog table stores Page Life Expectancy (PLE). PLE is an indicator of how long data pages remain in the SQL Server buffer pool; it is not a direct memory utilization percentage.

This query returns hourly average and minimum PLE.

SELECT
    DATEADD(HOUR, DATEDIFF(HOUR, 0, [LoggedAt ]), 0) AS HourlyTime,
    AVG(CAST([PageLifeExpectancy] AS FLOAT)) AS AvgPLE,
    MIN([PageLifeExpectancy]) AS MinPLE,
    MAX([PageLifeExpectancy]) AS MaxPLE,
    COUNT(*) AS SampleCount
FROM [DBADB].[dbo].[PageLifeExpectancyLog]
WHERE [LoggedAt ] >= DATEADD(DAY, -15, GETDATE())
  AND [LoggedAt ] <= GETDATE()
GROUP BY DATEADD(HOUR, DATEDIFF(HOUR, 0, [LoggedAt ]), 0)
ORDER BY HourlyTime DESC;




3. Daily CPU trend — last 15 days
Use this query for a simpler daily report.

SELECT
    CAST([Time] AS DATE) AS LogDate,
    AVG(CAST([SQLUtilisedCPU] AS FLOAT)) AS AvgSQLCPU,
    MAX(CAST([SQLUtilisedCPU] AS FLOAT)) AS PeakSQLCPU,
    AVG(CAST([Otherprosses] AS FLOAT)) AS AvgOtherCPU,
    AVG(CAST([IdleCPU] AS FLOAT)) AS AvgIdleCPU,
    COUNT(*) AS SampleCount
FROM [DBADB].[dbo].[CPUUtilisationdata]
WHERE [Time] >= DATEADD(DAY, -15, GETDATE())
  AND [Time] <= GETDATE()
GROUP BY CAST([Time] AS DATE)
ORDER BY LogDate DESC;



SELECT
    CAST([LoggedAt ] AS DATE) AS LogDate,
    AVG(CAST([PageLifeExpectancy] AS BIGINT)) AS AvgPLE,
    MIN([PageLifeExpectancy]) AS MinPLE,
    MAX([PageLifeExpectancy]) AS PeakPLE,
    COUNT(*) AS SampleCount
FROM [DBADB].[dbo].[PageLifeExpectancyLog]
WHERE [LoggedAt ] >= DATEADD(DAY, -15, GETDATE())
  AND [LoggedAt ] <= GETDATE()
GROUP BY CAST([LoggedAt ] AS DATE)
ORDER BY LogDate DESC;



1. Daily disk utilization and capacity trend

USE [DBADB];
GO

;WITH DailyDrive AS
(
    SELECT
        CAST(CaptureTime AS DATE) AS LogDate,
        [ServerName] AS ServerName,
        DriveLetter,
        [VolumeName ] AS VolumeName,
        TotalDisk_GB,
        UsedDisk_GB,
        FreeDisk_GB,
        UsedPct,
        FreePct,
        GrowthPct,
        DiskFlag,
        ROW_NUMBER() OVER
        (
            PARTITION BY
                CAST(CaptureTime AS DATE),
                [ServerName],
                DriveLetter
            ORDER BY CaptureTime DESC
        ) AS rn
    FROM dbo.DiskDriveUsageHistory
    WHERE CaptureTime >= DATEADD(DAY, -16, GETDATE())
      AND CaptureTime <= GETDATE()
),
DailySnapshot AS
(
    SELECT *
    FROM DailyDrive
    WHERE rn = 1
),
DriveTrend AS
(
    SELECT *,
        LAG(UsedDisk_GB) OVER
        (
            PARTITION BY ServerName, DriveLetter
            ORDER BY LogDate
        ) AS PreviousUsedGB,
        LAG(FreeDisk_GB) OVER
        (
            PARTITION BY ServerName, DriveLetter
            ORDER BY LogDate
        ) AS PreviousFreeGB,
        LAG(UsedPct) OVER
        (
            PARTITION BY ServerName, DriveLetter
            ORDER BY LogDate
        ) AS PreviousUsedPct
    FROM DailySnapshot
)
SELECT
    LogDate,
    ServerName,
    DriveLetter,
    VolumeName,
    TotalDisk_GB,
    UsedDisk_GB,
    FreeDisk_GB,
    UsedPct,
    FreePct,
    DiskFlag,

    CAST(UsedDisk_GB - PreviousUsedGB AS DECIMAL(18,2))
        AS UsedGBChange,

    CASE
        WHEN PreviousUsedGB IS NULL THEN 'No Previous Data'
        WHEN UsedDisk_GB > PreviousUsedGB THEN 'INCREASE'
        WHEN UsedDisk_GB < PreviousUsedGB THEN 'DECREASE'
        ELSE 'NO CHANGE'
    END AS DiskUsageTrend,

    CAST(FreeDisk_GB - PreviousFreeGB AS DECIMAL(18,2))
        AS FreeGBChange,

    CASE
        WHEN PreviousFreeGB IS NULL THEN 'No Previous Data'
        WHEN FreeDisk_GB > PreviousFreeGB THEN 'INCREASE'
        WHEN FreeDisk_GB < PreviousFreeGB THEN 'DECREASE'
        ELSE 'NO CHANGE'
    END AS FreeSpaceTrend,

    CAST(UsedPct - PreviousUsedPct AS DECIMAL(10,2))
        AS UsedPctChange,

    CASE
        WHEN PreviousUsedPct IS NULL THEN 'No Previous Data'
        WHEN UsedPct > PreviousUsedPct THEN 'INCREASE'
        WHEN UsedPct < PreviousUsedPct THEN 'DECREASE'
        ELSE 'NO CHANGE'
    END AS UtilizationTrend

FROM DriveTrend
WHERE LogDate >= DATEADD(DAY, -15, CAST(GETDATE() AS DATE))
ORDER BY ServerName, DriveLetter, LogDate DESC;


2. Daily disk I/O trend — last 15 days

USE [DBADB];
GO

;WITH IOCounters AS
(
    SELECT
        CaptureTime,
        database_id,
        file_id,
        num_of_reads,
        num_of_writes,
        io_stall_read_ms,
        io_stall_write_ms,

        LAG(num_of_reads) OVER
        (
            PARTITION BY database_id, file_id
            ORDER BY CaptureTime
        ) AS PrevReads,

        LAG(num_of_writes) OVER
        (
            PARTITION BY database_id, file_id
            ORDER BY CaptureTime
        ) AS PrevWrites,

        LAG(io_stall_read_ms) OVER
        (
            PARTITION BY database_id, file_id
            ORDER BY CaptureTime
        ) AS PrevReadStall,

        LAG(io_stall_write_ms) OVER
        (
            PARTITION BY database_id, file_id
            ORDER BY CaptureTime
        ) AS PrevWriteStall
    FROM dbo.DiskIO_History
    WHERE CaptureTime >= DATEADD(DAY, -16, GETDATE())
      AND CaptureTime <= GETDATE()
),
IODeltas AS
(
    SELECT *,
        num_of_reads - PrevReads AS ReadDelta,
        num_of_writes - PrevWrites AS WriteDelta,
        io_stall_read_ms - PrevReadStall AS ReadStallDelta,
        io_stall_write_ms - PrevWriteStall AS WriteStallDelta
    FROM IOCounters
    WHERE PrevReads IS NOT NULL
      AND PrevWrites IS NOT NULL
      AND PrevReadStall IS NOT NULL
      AND PrevWriteStall IS NOT NULL
),
ValidIO AS
(
    SELECT *
    FROM IODeltas
    WHERE ReadDelta >= 0
      AND WriteDelta >= 0
      AND ReadStallDelta >= 0
      AND WriteStallDelta >= 0
      AND CaptureTime >= DATEADD(DAY, -15, GETDATE())
)
SELECT
    CAST(CaptureTime AS DATE) AS LogDate,
    SUM(ReadDelta) AS TotalReadOperations,
    SUM(WriteDelta) AS TotalWriteOperations,
    SUM(ReadStallDelta) AS TotalReadStallMS,
    SUM(WriteStallDelta) AS TotalWriteStallMS,

    CAST(
        1.0 * SUM(ReadStallDelta)
        / NULLIF(SUM(ReadDelta), 0)
        AS DECIMAL(12,2)
    ) AS AvgReadLatencyMS,

    CAST(
        1.0 * SUM(WriteStallDelta)
        / NULLIF(SUM(WriteDelta), 0)
        AS DECIMAL(12,2)
    ) AS AvgWriteLatencyMS,

    COUNT(*) AS FileSnapshotCount
FROM ValidIO
GROUP BY CAST(CaptureTime AS DATE)
ORDER BY LogDate DESC;



